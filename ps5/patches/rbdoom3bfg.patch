 	int			len;
@@ -422,6 +431,15 @@ Sys_ReLaunch
 */
 void Sys_ReLaunch()
 {
+#if defined( __PROSPERO__ )
+	// PS5: no fork or exec in a title. The settings are saved, then the system
+	// starts the title's own eboot again in place of this one (as a console game
+	// restarts itself); it returns only if it could not
+	cmdSystem->ExecuteCommandText( "writeconfig " CONFIG_FILE "\n" );
+	const int result = sceSystemServiceLoadExec( "/app0/eboot.bin", NULL );
+	common->Warning( "Sys_ReLaunch: sceSystemServiceLoadExec failed (0x%08x); restart the game for this change", result );
+	return;
+#endif
 	// DG: implementing this... basic old fork() exec() (+ setsid()) routine..
 	// NOTE: this function used to have parameters: the commandline arguments, but as one string..
 	//       for Linux/Unix we want one char* per argument so we'll just add the friggin'
@@ -511,6 +529,34 @@ main
 */
 int main( int argc, const char** argv )
 {
+#if defined( __PROSPERO__ )
+	// PS5: a title is started with no arguments. The pad is the only input, so it
+	// is always on (the saved config cannot turn it off); no log file, since a write
+	// to the title's folder costs about 145 ms on the console (+set logFile 1 in
+	// /app0/userdata/args.txt for /app0/userdata/base/qconsole.log). args.txt may
+	// add more, as on a command line
+	static idStrList ps5Args;
+	static const char* ps5Argv[ 64 ];
+	ps5Args.Append( "RBDoom3BFG" );
+	ps5Args.Append( "+set" );
+	ps5Args.Append( "in_useJoystick" );
+	ps5Args.Append( "1" );
+	if( FILE* argsFile = fopen( "/app0/userdata/args.txt", "r" ) )
+	{
+		char word[ 256 ];
+		while( fscanf( argsFile, "%255s", word ) == 1 && ps5Args.Num() < 64 )
+		{
+			ps5Args.Append( word );
+		}
+		fclose( argsFile );
+	}
+	for( int i = 0; i < ps5Args.Num(); i++ )
+	{
+		ps5Argv[ i ] = ps5Args[ i ].c_str();
+	}
+	argc = ps5Args.Num();
+	argv = ps5Argv;
+#endif
 	// DG: needed for Sys_ReLaunch()
 	cmdargc = argc;
 	cmdargv = argv;
